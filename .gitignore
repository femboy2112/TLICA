# Generated PDF reading copies. The Markdown files are authoritative; PDFs are
# an on-demand artifact built with `make pdfs` and are deliberately not tracked
# (a committed PDF goes stale the moment its Markdown source is edited).
/output/

# Generated GitHub Wiki mirror. docs/ is authoritative; `make wiki` clones the
# separate TLICA.wiki.git repo here and regenerates it -- not tracked in this repo.
/build/

# LaTeX build products. The PDF pipeline builds in a temp directory, but guard
# against any stray intermediates landing in the tree.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# Python probe/script caches
__pycache__/
*.py[cod]

# Editor and operating-system files
.DS_Store
*~
*.swp

# Moreish double-blind cut: local journal-submission artifact only (author direction); regenerate via blind_build.py
research/moreish_ontology_2026-09-13/publication_v1_0/MANUSCRIPT_v1_0_BLIND.md
